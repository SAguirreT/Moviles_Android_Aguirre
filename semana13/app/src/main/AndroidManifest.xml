<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- COMMIT 2: Permite obtener la ubicacion aproximada. -->
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- COMMIT 2: Permite obtener la ubicacion precisa. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:label="CampusGPS"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:supportsRtl="true">

        <!-- COMMIT 2: Google Maps obtiene la clave
             desde local.properties mediante Gradle. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Actividad principal de CampusGPS. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
